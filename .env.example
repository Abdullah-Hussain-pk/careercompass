# CareerCompass Environment Variables
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
POSTGRES_USER=careercompass
POSTGRES_PASSWORD=secret_change_me
POSTGRES_DB=careercompass

# Backend
SECRET_KEY=change_this_to_a_random_32_char_secret_key
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000

# SQLite fallback (for quick local tests without Docker)
# DATABASE_URL=sqlite+aiosqlite:///./careercompass.db
# DATABASE_URL_SYNC=sqlite:///./careercompass.db
