# demo uses local embedded PostgreSQL and fake accounts; never deploy demo mode
APP_MODE=demo
PORT=4001
WEB_ORIGIN=http://localhost:5174
# Generate a fresh random secret for your own local demo
JWT_SECRET=
DEMO_DATA_DIR=.data/demo
# Live mode uses Supabase Auth and Supabase PostgreSQL
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_SSL=true
# Set true when behind HTTPS in production
COOKIE_SECURE=false
NODE_ENV=development
